# Copie para .env. O comando do cartao "Como integrar" (Minha conta > Integracoes) grava as tres primeiras.
ATOS_ISSUER=https://atos.dev.br
ATOS_CLIENT_ID=
ATOS_REDIRECT_URI=http://127.0.0.1:3000/auth/atos/retorno
# O segredo do acesso confidencial (aparece uma vez so, quando e gerado).
ATOS_CLIENT_SECRET=
# Um texto aleatorio e comprido, para assinar o cookie da sessao da loja.
SESSION_SECRET=
