{
  "name": "@atos.dev.br/entrar",
  "version": "0.5.0",
  "description": "Entrar com Atos (OpenID Connect com PKCE, e o \"Continuar como\" do FedCM) no navegador e no Node, o botão oficial, o menu de conta e a conferência dos avisos da Atos, sem dependências.",
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
