    "pkce",
    "login",
    "webhook",
    "botao",
    "fedcm"
  ],
  "homepage": "https://atos.dev.br/integracao/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matheusuener-atos/atos.dev.br.git",
    "directory": "pacotes/entrar"
  },
  "scripts": {
    "test": "node --test \"teste/*.test.mjs\""
  }
}
